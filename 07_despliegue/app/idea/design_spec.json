{
  "schema_version": "2.0.0",
  "copy": {
    "title": "Explorador de riesgo crediticio",
    "panel_title": "Filtros",
    "primary_button": "Calcular riesgo",
    "empty_state": "Ajustá los filtros de la izquierda y calculá el riesgo para ver los resultados.",
    "result_title": "Pérdida esperada relativa",
    "result_note": "Resultado demostrativo; no es una decisión real de crédito.",
    "impact_heading": "Impacto de la pérdida esperada",
    "impact_threshold_label": "Línea de referencia: 5%",
    "metrics_heading": "Métricas de riesgo",
    "scenarios_heading": "Sensibilidad",
    "disclaimer": "Resultado demostrativo, no calibrado. No es una política de crédito, una oferta ni asesoramiento financiero."
  },
  "layout": {"breakpoints": [375, 768, 1024, 1440], "narrow_behavior": "stack", "filter_ratio": 1, "content_ratio": 3},
  "scale": {"max": 0.25, "threshold": 0.05, "warn": 0.10},
  "tokens": {
    "primitive": {"blue": "#1E40AF", "blue_deep": "#1E3A8A", "sky": "#3B82F6", "slate": "#1E293B", "muted": "#475569", "canvas": "#F8FAFC", "panel": "#F1F5F9", "surface": "#FFFFFF", "border": "#E2E8F0", "green": "#15803D", "amber": "#B45309", "red": "#B91C1C"},
    "semantic": {"background": "#F8FAFC", "panel": "#F1F5F9", "surface": "#FFFFFF", "foreground": "#1E293B", "muted": "#475569", "border": "#E2E8F0", "primary": "#1E40AF", "focus_ring": "#1E40AF", "within": "#15803D", "near": "#B45309", "outside": "#B91C1C"}
  },
  "visible_fields": {
    "principal": {"widget": "slider", "min": 1000, "max": 40000, "step": 500, "default": 10000, "label": "Principal (importe del préstamo)", "format": "%d", "help": "Monto solicitado por el cliente."},
    "num_cuotas": {"widget": "radio", "options": ["36 months", "60 months"], "default": "36 months", "label": "Plazo", "help": "Cantidad de cuotas del préstamo."},
    "tipo_interes": {"widget": "slider", "min": 0.05, "max": 0.35, "step": 0.01, "default": 0.15, "label": "Tipo de interés", "format": "%.2f", "help": "Tasa en el formato que espera la API (ej. 0.15 equivale a 15%)."},
    "imp_cuota": {"widget": "slider", "min": 50, "max": 2000, "step": 10, "default": 350, "label": "Importe de la cuota", "format": "%d"},
    "ingresos": {"widget": "slider", "min": 5000, "max": 300000, "step": 1000, "default": 50000, "label": "Ingresos anuales", "format": "%d"},
    "dti": {"widget": "slider", "min": 0.0, "max": 40.0, "step": 0.5, "default": 15.0, "label": "DTI (deuda sobre ingresos)", "format": "%.1f", "help": "Relación entre deuda y ingresos, en porcentaje."},
    "porc_uso_revolving": {"widget": "slider", "min": 0, "max": 100, "step": 1, "default": 40, "label": "Uso de crédito revolving (%)"},
    "rating": {"widget": "selectbox", "options": ["A", "B", "C", "D", "E", "F", "G"], "default": "B", "label": "Rating interno"}
  },
  "hidden_fields": {
    "ingresos_verificados": "Source Verified",
    "vivienda": "RENT",
    "finalidad": "debt_consolidation",
    "antigüedad_empleo": "5 years",
    "num_lineas_credito": 12,
    "num_derogatorios": 0
  },
  "result_view": {"metrics": ["score_pd", "score_ead", "score_lgd", "perdida_esperada_relativa"], "formula": "PD × EAD × LGD"},
  "scenarios": {"principal_factors": [0.8, 0.9, 1.0], "terms": ["36 months", "60 months"], "max_qualifying": 6, "label": "Escenarios de sensibilidad ceteris-paribus; no son ofertas ni recomendaciones."}
}
